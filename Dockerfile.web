# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
WORKDIR /app

# Отключаем телеметрию Astro и ограничиваем кучу V8, чтобы сборка не вызывала OOM/своп на старом ПК
ENV ASTRO_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS="--max-old-space-size=768"

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# В стадию сборки копируем из public/ только те файлы, которые реально читаются скриптами при сборке
# (price.xlsx для генерации /price.json и ink-логотипы для подсчёта хешей ?v=).
# Все остальные ~2000 файлов (137 МБ статики и 3D-тура) копируются напрямую в финальный образ один раз.
COPY astro.config.mjs ./
COPY public/assets/price.xlsx ./public/assets/price.xlsx
COPY public/img/logos/ink ./public/img/logos/ink
COPY src ./src
RUN npm run build && rm -rf dist/assets dist/img

FROM nginx:1.28-alpine

RUN apk add --no-cache openssl \
    && rm -f /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/nginx.conf
COPY server/init.d/app.conf /etc/nginx/conf.d/app.conf
COPY server/docker-entrypoint.d/ /docker-entrypoint.d/
RUN sed -i 's/\r$//' /docker-entrypoint.d/*.sh \
    && chmod +x /docker-entrypoint.d/*.sh \
    && mkdir -p /etc/nginx/cert /var/www/letsencrypt \
    && openssl req -x509 -nodes -newkey rsa:2048 -days 1 \
       -keyout /etc/nginx/cert/key.key -out /etc/nginx/cert/crt.crt -subj "/CN=localhost" >/dev/null 2>&1 \
    && nginx -t \
    && rm -rf /etc/nginx/cert/*

# Сначала кладём статику public/ (слой кэшируется Docker при изменениях в src/),
# затем поверх кладём собранный Astro-вывод (HTML, CSS, JS, price.json) сразу с нужным владельцем
COPY --chown=nginx:nginx public /usr/share/nginx/html
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

# Предсжатие текстовых ассетов на этапе сборки (для gzip_static on в nginx):
# экономит процессорное время старого сервера и уменьшает размер файлов при загрузке
RUN find /usr/share/nginx/html -type f \
      \( -name '*.html' -o -name '*.css' -o -name '*.js' -o -name '*.mjs' \
         -o -name '*.json' -o -name '*.svg' -o -name '*.xml' -o -name '*.txt' \) \
      -exec sh -c 'for f do gzip -9 -c "$f" > "$f.gz" && (touch -r "$f" "$f.gz" 2>/dev/null || true) && chown nginx:nginx "$f.gz"; done' sh {} +

EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-check-certificate -qO- https://127.0.0.1/healthz >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
