---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Equipment from '../components/Equipment.astro';
import StripObjects from '../components/StripObjects.astro';
import Tests from '../components/Tests.astro';
import Calc from '../components/Calc.astro';
import Contacts from '../components/Contacts.astro';
---
<Base title="Оборудование и испытания — МОСТДОРГЕОТРЕСТ" active="eq" light>
  <PageHead
    eyebrow="Инструменты и методы"
    title="Оборудование лаборатории"
    sub="Парк современного оборудования, виды испытаний и образцы протоколов, выдаваемых лабораторией."
  />
  <Equipment />
  <StripObjects />
  <Tests />
  <Calc />
  <Contacts subpage />
</Base>
