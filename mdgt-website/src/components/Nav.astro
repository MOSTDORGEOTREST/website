---
interface Props { active?: string; home?: boolean }
const { active = '', home = false } = Astro.props;
---
<header class="nav" id="nav">
  <a class="nav-brand" href={home ? "#hero" : "/"} data-scroll>
    <img src="/img/mdgt.png" alt="Логотип МОСТДОРГЕОТРЕСТ" width="36" height="36" />
    <span class="nb"><b>МОСТДОРГЕОТРЕСТ</b><span>lab · since 2008</span></span>
  </a>
  <nav aria-label="Основная навигация">
    <ul class="nav-links">
      <li><a href="/#descent" data-scroll data-nav>Лаборатории</a></li>
      <li><a href="/#objects" data-scroll data-nav>Объекты</a></li>
      <li><a href="/oborudovanie/" class:list={[active === "eq" && "active"]}>Оснащение</a></li>
      <li><a href="/kursy/" class:list={[active === "edu" && "active"]}>Курсы</a></li>
      <li><a href="/soft/" class:list={[active === "soft" && "active"]}>Софты</a></li>
      <li><a href="/#contacts" data-scroll data-nav>Контакты</a></li>
    </ul>
  </nav>
  <div style="display:flex;align-items:center;gap:12px">
    <a class="nav-tour" href="https://mdgt.ru/3d/output-3/index.html" target="_blank" rel="noopener" title="Онлайн-тур по лаборатории">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 4 5.7 4 9s-1.5 6.4-4 9c-2.5-2.6-4-5.7-4-9s1.5-6.4 4-9z"/></svg>
      <span>3D-тур</span>
    </a>
    <a class="nav-cta" href="/#contacts" data-scroll>+7 495 656-69-10</a>
    <button class="burger" id="burger" aria-label="Открыть меню" aria-expanded="false"><i></i></button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu">
  <a href="/#descent" data-scroll><i>01</i>Лаборатории</a>
  <a href="/#objects" data-scroll><i>02</i>Объекты</a>
  <a href="/oborudovanie/"><i>03</i>Оснащение</a>
  <a href="/kursy/"><i>04</i>Курсы</a>
  <a href="/soft/"><i>05</i>Софты</a>
  <a href="/#contacts" data-scroll><i>06</i>Контакты</a>
  <a href="https://mdgt.ru/3d/output-3/index.html" target="_blank" rel="noopener"><i>3D</i>Онлайн-тур</a>
</div>
