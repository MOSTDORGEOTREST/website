<script>
  /* фильтр парка по направлениям */
  const grid = document.getElementById('eq-grid');
  if (grid) {
    const tabs = Array.from(document.querySelectorAll('.eq-tab'));
    const cards = Array.from(grid.querySelectorAll('.eq-card'));
    const count = document.getElementById('eq-count');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const f = (tab as HTMLElement).dataset.eqf;
      tabs.forEach((t) => { t.classList.toggle('on', t === tab); t.setAttribute('aria-pressed', String(t === tab)); });
      let n = 0;
      cards.forEach((card) => {
        const isCta = card.hasAttribute('data-cta');
        const show = isCta || f === 'all' || (card as HTMLElement).dataset.cat === f;
        card.classList.toggle('eq-hide', !show);
        if (show) { if (!isCta) n++; card.classList.remove('eq-pop'); void (card as HTMLElement).offsetWidth; card.classList.add('eq-pop'); }
      });
      if (count) count.textContent = String(n);
      /* высота секции меняется — пусть ScrollTrigger пересчитает пины */
      window.dispatchEvent(new Event('resize'));
    }));
  }
</script>
