---
import Nav from '../components/Nav.astro';
import PriceModal from '../components/PriceModal.astro';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: string;   // активный пункт меню: eq | edu | soft
  light?: boolean;   // подстраницы стартуют в светлой теме
  home?: boolean;    // главная (лого ведёт на #hero)
}
const SITE = 'https://mdgt.ru';
const canonical = new URL(Astro.url.pathname, SITE).href;
const {
  title,
  description = 'Геотехническая лаборатория АО «МОСТДОРГЕОТРЕСТ» — лидер в лабораторных испытаниях грунтов с 2008 года.',
  active = '',
  light = false,
  home = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/img/mdgt.png" />
  <meta name="theme-color" content={light ? '#F2ECDF' : '#111826'} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${SITE}/img/mdgt.png`} />
  <link rel="canonical" href={canonical} />
  <!-- мгновенный фон до прихода стилей -->
  <style is:inline set:html={`html{background:${light ? '#F2ECDF' : '#111826'}}`}></style>
  <!-- ключевые шрифты — не ждать остальных -->
  <link rel="preload" href="/fonts/unbounded-cyrillic-800-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body id="body" class:list={[light && 'on-light']}>
<a class="skip-link" href="#main">Перейти к содержанию</a>
<div class="grain" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>
<div class="cursor-dot" aria-hidden="true"></div>
<div class="cursor-ring" aria-hidden="true"><span>Дальше</span></div>

<slot name="loader" />

<Nav active={active} home={home} />

<slot name="hud" />

<main id="main">
  <slot />
</main>

<PriceModal />

<script src="../scripts/main.js"></script>
</body>
</html>
