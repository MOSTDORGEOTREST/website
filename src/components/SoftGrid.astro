          <span class="paper-item-title">{paper.title}</span>
          <span class="paper-copy">{paper.summary}</span>
          <span class="paper-source">{paper.source}</span>
          <span class="paper-authors">{paper.authors}</span>
          <span class="paper-tags">{paper.tags.map((tag) => <span>{tag}</span>)}</span>
          {paper.href ? (
            <svg class="paper-item-arrow" viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg>
          ) : (
            <span class="paper-no-link">Архивная запись</span>
          )}
        </a>
      ))}
    </div>

    <div class="rinz-block">
      <div class="rinz-head">
        <div>
          <span class="d-eyebrow">Научный архив</span>
          <h3>Публикации в РИНЦ</h3>
        </div>
        <p>Полные библиографические карточки и показатели цитирования в национальной научной электронной библиотеке.</p>
      </div>
      <div class="rinz-list">
        {elibraryIds.map((id, index) => (
          <a class="rinz-row" href={`https://www.elibrary.ru/item.asp?id=${id}`} target="_blank" rel="noopener">
            <span class="rinz-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="rinz-mark">РИНЦ</span>
            <span class="rinz-name">Библиографическая карточка публикации</span>
            <span class="rinz-id">eLIBRARY ID {id}</span>
            <svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
