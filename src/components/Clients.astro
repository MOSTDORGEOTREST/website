---
/* Акт 04 «Нам доверяют»: логотипы заказчиков по образцу блока «Brands using GSAP®» на gsap.com.
   Под заголовком — один ряд из шести колонок без рамок. Логотипы
   одноцветные (public/img/logos/ink/, генерирует scripts/logo-ink.py). В каждой колонке
   свои логотипы лежат стопкой и сменяются по очереди: знак держится 3 с, уезжает за край
   колонки, следующий въезжает с другой оси; колонки сдвинуты на 0,2 с — получается волна.
   Колонки чередуются: компактные эмблемы / широкие надписи (К Ш К Ш К Ш).
   На планшете ряд складывается в 2×3, на телефоне в 3×2 «змейкой».
   Без JS видна первая эмблема каждой колонки; полный список — для читалок экрана. */
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import logos from '../logos.json';

type Logo = { file: string; alt: string; w: number; h: number };
/* ?v=хеш содержимого: /img/ кешируется на неделю, а файлы могут меняться под тем же именем */
const ver = (file: string) => {
  try { return '?v=' + createHash('sha1').update(readFileSync(join(process.cwd(), 'public', file))).digest('hex').slice(0, 8); }
  catch { return ''; }
};
const items = (logos as Logo[]).map((l) => {
  const ink = l.file.replace('/img/logos/', '/img/logos/ink/');
  const r = l.w / l.h;
  return { ...l, src: ink + ver(ink), r, k: Math.min(1, Math.pow(r, -0.26)) };
});
/* компактные знаки — в колонки 1, 3, 5; широкие надписи — в 2, 4, 6 */
const cols: (typeof items)[] = [[], [], [], [], [], []];
items.filter((l) => l.r < 2.2).forEach((l, i) => cols[[0, 2, 4][i % 3]].push(l));
items.filter((l) => l.r >= 2.2).forEach((l, i) => cols[[1, 3, 5][i % 3]].push(l));
---
<section id="clients" class="light-sec" aria-labelledby="clients-title">
  <div class="wrap sec-head" style="margin-bottom:0">
    <span class="d-eyebrow">Акт 04 · Доверие</span>
    <h2 id="clients-title">Нам доверяют</h2>
  </div>
  <div class="wrap">
    <ul class="sr-only" aria-label="Наши заказчики">
      {items.map((l) => <li>{l.alt}</li>)}
    </ul>
    <div class="cl-row" id="client-row" aria-hidden="true">
      {cols.map((c, ci) => (
        <div class:list={['cl-col', ci % 2 ? 'cl-col--w' : 'cl-col--c']}>
          {c.map((l) => (
            <img class="cl-logo" src={l.src} alt="" width={l.w} height={l.h} style={`--k:${l.k.toFixed(3)};--r:${l.r.toFixed(3)}`} loading="lazy" decoding="async" />
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
