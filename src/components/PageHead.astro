---
interface Props { eyebrow: string; title: string; sub: string }
const { eyebrow, title, sub } = Astro.props;
---
<section class="page-head" aria-label="Заголовок страницы">
  <div class="wrap">
    <a class="ph-back" href="/">&larr;&nbsp;На главную</a>
    <span class="d-eyebrow" style="color:var(--emerald-d)">{eyebrow}</span>
    <h1 class="ph-title">{title}</h1>
    <p class="sec-sub">{sub}</p>
  </div>
</section>
