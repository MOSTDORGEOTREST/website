<script>
  import type HlsType from 'hls.js';

  const sec = document.getElementById('live');
  if (sec) {
    const cards = Array.from(sec.querySelectorAll('.live-card'));
    let started = false;
    let Hls: typeof HlsType;

    function initCard(card: Element) {
      const video = card.querySelector('video');
      const src = (card as HTMLElement).dataset.src;
      if (!video || !src) return;
      const off = () => { card.classList.remove('is-live'); card.classList.add('is-off'); };
      const live = () => { card.classList.remove('is-off'); card.classList.add('is-live'); };
      video.addEventListener('playing', live);

      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        /* Safari — нативный HLS */
        video.addEventListener('error', off);
        video.src = src;
        video.play().catch(() => {});
      } else if (Hls.isSupported()) {
        const hls = new Hls({ enableWorker: true, maxBufferLength: 12, liveSyncDurationCount: 3, manifestLoadingMaxRetry: 2 });
        hls.on(Hls.Events.ERROR, (_e: unknown, data: { fatal?: boolean }) => {
          if (data && data.fatal) { hls.destroy(); off(); }
        });
        hls.on(Hls.Events.MANIFEST_PARSED, () => { video.play().catch(() => {}); });
        hls.loadSource(src);
        hls.attachMedia(video);
      } else { off(); return; }

      /* сторожок: если эфир не пошёл за 12 с — честно показываем «офлайн» */
      setTimeout(() => { if (!card.classList.contains('is-live')) off(); }, 12000);
    }

    async function boot() {
      if (started) return; started = true;
      /* hls.js тяжёлый — грузим его лениво, только когда секция в зоне видимости */
      try { Hls = (await import('hls.js')).default; }
      catch { cards.forEach((c) => c.classList.add('is-off')); return; }
      /* камеры включаются каскадом — не бьём канал шестью манифестами разом */
      cards.forEach((card, i) => setTimeout(() => initCard(card), i * 450));
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries, io) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); boot(); }
      }, { rootMargin: '480px' }).observe(sec);
    } else boot();
  }
</script>
