---
/* Знаковые объекты. Порядок задан заказчиком; подпись у каждой панели
   собрана по одной схеме: тип · место — название — один точный факт.
   Кадры лежат в /img/objects/*.webp, подготовлены под кроп 1.45 (десктоп)
   и 0.76 (телефон): сюжет в каждом снимке выведен в центр. */
const OBJECTS = [
  { img: 'krymsky-most',        tag: 'Мост · Керченский пролив',      name: 'Крымский мост',
    sub: '19 километров над проливом — самый длинный мост России',
    alt: 'Крымский мост через Керченский пролив' },
  { img: 'aes-akkuyu',          tag: 'Атомная станция · Турция',      name: 'АЭС «Аккую»',
    sub: 'Первая АЭС Турции: четыре блока ВВЭР-1200, 4800 МВт',
    alt: 'Строительство АЭС «Аккую» на средиземноморском побережье Турции' },
  { img: 'kosmodrom-vostochny', tag: 'Космодром · Амурская область',  name: 'Космодром Восточный',
    sub: 'Первый гражданский космодром России',
    alt: 'Стартовый комплекс космодрома Восточный с ракетой на пусковом столе' },
  { img: 'badaevsky',           tag: 'Жилой комплекс · Москва',       name: '«Бадаевский»',
    sub: 'Корпуса Herzog & de Meuron, поднятые на опорах над парком',
    alt: 'Жилой комплекс «Бадаевский» на Кутузовском проспекте в Москве' },
  { img: 'dom-pravitelstva',    tag: 'Общественное здание · Москва',  name: 'Дом Правительства России',
    sub: 'Белый дом на Краснопресненской набережной',
    alt: 'Дом Правительства Российской Федерации в Москве' },
  { img: 'lakhta-center',       tag: 'Небоскрёб · Санкт-Петербург',   name: '«Лахта Центр»',
    sub: '462 метра — самое высокое здание Европы',
    alt: 'Небоскрёб «Лахта Центр» в Санкт-Петербурге' },
  { img: 'novy-khersones',      tag: 'Музейный комплекс · Севастополь', name: '«Новый Херсонес»',
    sub: 'Музеи и парк у древнего Херсонеса Таврического',
    alt: 'Музейный комплекс «Новый Херсонес» в Севастополе' },
  { img: 'sheremetyevo',        tag: 'Аэропорт · Москва',             name: 'Шереметьево',
    sub: 'Крупнейший аэропорт России по пассажиропотоку',
    alt: 'Аэропорт Шереметьево, вид на терминал и перрон' },
];
const total = String(OBJECTS.length).padStart(2, '0');
---
<section id="objects" aria-label="Знаковые объекты">
  <div class="h-view" id="h-view">
    <div class="h-track" id="h-track">
      <div class="h-head">
        <span class="d-eyebrow">Акт 03 · Наверху</span>
        <h2>Наши испытания — в основании страны</h2>
        <div class="h-stat">
          <b>1000<i>+</i></b>
          <span><i>объектов</i><i>за 18 лет работы</i></span>
        </div>
        <p>Каждый из этих объектов начинался у нас — с образца грунта на предметном столике.
           Энергоблоки АЭС и плотины ГЭС, мосты и аэропорты, жилые кварталы и заводские цеха —
           от Балтики до Сахалина, от Сочи до Заполярья.</p>
        <div class="h-arrow">Двигаемся вдоль</div>
      </div>
      {OBJECTS.map((o, i) => (
        <div class="pan" data-i={String(i + 1).padStart(2, '0')}>
          <span class="pan-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="pan-mask">
            {/* первые две панели грузим сразу, остальные — по приближении секции */}
            {i < 2
              ? <div class="pan-img" style={`background-image:url('/img/objects/${o.img}.webp')`} role="img" aria-label={o.alt}></div>
              : <div class="pan-img" data-bg={`/img/objects/${o.img}.webp`} role="img" aria-label={o.alt}></div>}
          </div>
          <div class="pan-cap">
            <span class="pc-tag">{o.tag}</span>
            <h3>{o.name}</h3>
            <div class="pc-sub">{o.sub}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="h-progress" aria-hidden="true"><i id="h-fill"></i></div>
    <div class="h-count" id="h-count" aria-hidden="true">01 / {total}</div>
  </div>
</section>
