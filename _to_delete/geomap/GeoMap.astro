---
/* География объектов — лёгкая карта на canvas: без тайлов, без библиотек.
   Силуэт России и линии соседей лежат в src/data/geo.json дельта-кодом
   в сотых долях градуса (~9 КБ), точки — парами координат.
   Проекция считается в рантайме, поэтому один и тот же набор данных
   обслуживает и общий вид, и приближение к Москве. */
import geo from '../data/geo.json';
---
<section id="geography" class="geo" aria-labelledby="geo-title">
  <div class="wrap">
    <div class="geo-head">
      <div class="geo-intro">
        <span class="d-eyebrow">Акт 03 · Карта</span>
        <h2 id="geo-title">География объектов</h2>
        <p>Каждая точка — площадка, грунт с которой прошёл через лабораторию.
           Ядро — Москва и область, дальше страна: от Балтики до Сахалина, от Сочи до Заполярья.</p>
      </div>
      <div class="geo-ctl" role="group" aria-label="Масштаб карты">
        <button type="button" class="geo-btn on" data-view="all" aria-pressed="true">Вся страна</button>
        <button type="button" class="geo-btn" data-view="msk" aria-pressed="false">Москва</button>
      </div>
    </div>

    <figure class="geo-fig">
      <figcaption class="geo-note" id="geo-note">Россия · 695 площадок</figcaption>
      <canvas id="geo-canvas" role="img"
        aria-label="Карта площадок: 695 объектов от Балтики до Сахалина, основная часть — Москва и Московская область"></canvas>
      <figcaption class="geo-read" id="geo-read" aria-live="polite"><span>наведите на точку</span></figcaption>
    </figure>

    <dl class="geo-facts">
      <div><dt>Площадок на карте</dt><dd>695</dd></div>
      <div><dt>Москва и область</dt><dd>618</dd></div>
      <div><dt>Разброс по долготе</dt><dd>22° … 142°</dd></div>
      <div><dt>Самая северная</dt><dd>69,5° с. ш. · Норильск</dd></div>
    </dl>
  </div>
</section>

<script is:inline define:vars={{ GEO: geo }}>
  (function(){
    var cv = document.getElementById('geo-canvas');
    if(!cv || !cv.getContext) return;
    var ctx = cv.getContext('2d');
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- распаковка дельта-кода: сотые доли градуса, пары lon/lat ---- */
    function decode(s){
      if(!s) return [];
      return s.split(';').map(function(seg){
        var v = seg.split(',').map(Number), out = [[v[0]/100, v[1]/100]];
        for(var i=2;i<v.length;i+=2){
          out.push([out[out.length-1][0]+v[i]/100, out[out.length-1][1]+v[i+1]/100]);
        }
        return out;
      });
    }
    var RU = decode(GEO.ru), NB = decode(GEO.nb);
    var PTS = GEO.pts.split(';').map(function(p){ var a=p.split(','); return [ +a[1], +a[0] ]; }); // [lon,lat]

    /* ---- коническая равновеликая проекция Альберса: для России честнее меркатора ---- */
    var P1=50*Math.PI/180, P2=65*Math.PI/180, L0=100*Math.PI/180, F0=56*Math.PI/180;
    var N=(Math.sin(P1)+Math.sin(P2))/2;
    var C=Math.cos(P1)*Math.cos(P1)+2*N*Math.sin(P1);
    var RHO0=Math.sqrt(C-2*N*Math.sin(F0))/N;
    function proj(lon,lat){
      var lam=lon*Math.PI/180, phi=lat*Math.PI/180;
      var rho=Math.sqrt(Math.max(C-2*N*Math.sin(phi),1e-9))/N, th=N*(lam-L0);
      return [rho*Math.sin(th), RHO0-rho*Math.cos(th)];
    }
    function unproj(x,y){
      var ry=RHO0-y, rho=Math.hypot(x,ry), th=Math.atan2(x,ry);
      var sinPhi=(C-rho*rho*N*N)/(2*N);
      return [ (L0+th/N)*180/Math.PI, Math.asin(Math.max(-1,Math.min(1,sinPhi)))*180/Math.PI ];
    }

    /* ---- камера живёт в координатах проекции: так перелёт между видами
           линеен, а посадка кадра считается сама под любую пропорцию canvas ---- */
    var W=0, H=0, DPR=1, scale=1;
    var cam={x:0,y:0,span:1}, target={x:0,y:0,span:1}, from={x:0,y:0,span:1}, anim=1;
    var VIEWS={};

    function fit(pointsLonLat, pad){
      var x0=1e9,x1=-1e9,y0=1e9,y1=-1e9;
      pointsLonLat.forEach(function(p){
        var q=proj(p[0],p[1]);
        if(q[0]<x0)x0=q[0]; if(q[0]>x1)x1=q[0];
        if(q[1]<y0)y0=q[1]; if(q[1]>y1)y1=q[1];
      });
      var sx=(x1-x0)/2, sy=(W&&H ? (W/H)*(y1-y0)/2 : (y1-y0)/2);
      return { x:(x0+x1)/2, y:(y0+y1)/2, span:Math.max(sx,sy,1e-4)*(1+(pad||0.06)) };
    }
    function buildViews(){
      var ruPts=[]; RU.forEach(function(r){ r.forEach(function(pt){ ruPts.push(pt); }); });
      VIEWS.all = fit(ruPts, 0.05);
      var msk = PTS.filter(function(p){ return p[1]>55.4 && p[1]<56.1 && p[0]>37.1 && p[0]<38.0; });
      VIEWS.msk = fit(msk.length?msk:PTS, 0.16);
    }

    function layout(){
      DPR = Math.min(devicePixelRatio||1, 2);
      W = cv.clientWidth; H = cv.clientHeight;
      cv.width = Math.round(W*DPR); cv.height = Math.round(H*DPR);
      ctx.setTransform(DPR,0,0,DPR,0,0);
      var was = current;                 /* пропорция изменилась — пересаживаем кадр */
      buildViews();
      if(anim>=1){ cam=Object.assign({},VIEWS[was]); target=Object.assign({},VIEWS[was]); }
    }
    function setCam(){ scale=(W/2)/cam.span; }
    var toX = function(p){ return W/2 + (p[0]-cam.x)*scale; };
    var toY = function(p){ return H/2 + (p[1]-cam.y)*scale; };
    var current='all';

    /* ---- цвета берём из темы, чтобы карта жила вместе с палитрой ---- */
    function css(v, fb){ var s=getComputedStyle(document.documentElement).getPropertyValue(v).trim(); return s||fb; }

    var reveal = 0;               /* 0..1 — проявление точек от Москвы наружу */
    var hoverI = -1;
    var order = null;             /* индексы точек, отсортированные по удалению от Москвы */

    function buildOrder(){
      var m = proj(37.617,55.752);
      order = PTS.map(function(p,i){
        var q=proj(p[0],p[1]);
        return [i, Math.hypot(q[0]-m[0], q[1]-m[1])];
      }).sort(function(a,b){ return a[1]-b[1]; });
      var max = order.length ? order[order.length-1][1] : 1;
      order.forEach(function(o){ o[1] = o[1]/max; });
    }

    function draw(){
      if(!W||!H) return;
      setCam();
      ctx.clearRect(0,0,W,H);
      var ink   = css('--ink-d','#221A0E');
      var emer  = css('--emerald-rgb','10,110,54');
      var amber = css('--amber-d','#A66A14');

      /* сетка меридианов и параллелей — тот же приборный язык, что на планете.
         Шаг подбирается под масштаб: 10° на страну, доли градуса на город */
      var c1=unproj(cam.x-cam.span, cam.y-cam.span*H/W),
          c2=unproj(cam.x+cam.span, cam.y+cam.span*H/W);
      /* запас берём долей от видимого куска, а не фиксированными градусами:
         на городском масштабе двойка градусов растягивала шаг сетки в пять раз */
      var loR=Math.abs(c2[0]-c1[0]), laR=Math.abs(c2[1]-c1[1]);
      var loA=Math.min(c1[0],c2[0])-loR*0.25, loB=Math.max(c1[0],c2[0])+loR*0.25;
      var laA=Math.min(c1[1],c2[1])-laR*0.25, laB=Math.max(c1[1],c2[1])+laR*0.25;
      var STEPS=[20,10,5,2,1,.5,.2,.1,.05];
      var step=STEPS[0];
      for(var si=0; si<STEPS.length; si++){ step=STEPS[si]; if((laB-laA)/step >= 5) break; }
      var dLat=Math.max((laB-laA)/60, step/20);
      ctx.lineWidth=1; ctx.strokeStyle='rgba('+emer+',.22)';
      for(var lon=Math.ceil(loA/step)*step; lon<=loB; lon+=step){
        ctx.beginPath();
        for(var la=laA; la<=laB; la+=dLat){ var p=proj(lon,la);
          la===laA?ctx.moveTo(toX(p),toY(p)):ctx.lineTo(toX(p),toY(p)); }
        ctx.stroke();
      }
      var dLon=Math.max((loB-loA)/90, step/20);
      for(var lat=Math.ceil(laA/step)*step; lat<=laB; lat+=step){
        ctx.beginPath();
        for(var lo=loA; lo<=loB; lo+=dLon){ var p2=proj(lo,lat);
          lo===loA?ctx.moveTo(toX(p2),toY(p2)):ctx.lineTo(toX(p2),toY(p2)); }
        ctx.stroke();
      }

      /* соседи — волосяной контур, только контекст */
      ctx.strokeStyle='rgba(34,26,14,.10)'; ctx.lineWidth=1;
      NB.forEach(function(l){
        ctx.beginPath();
        l.forEach(function(pt,i){ var p=proj(pt[0],pt[1]); i?ctx.lineTo(toX(p),toY(p)):ctx.moveTo(toX(p),toY(p)); });
        ctx.stroke();
      });

      /* Россия — заливка силуэтом */
      ctx.fillStyle='rgba(34,26,14,.10)'; ctx.strokeStyle='rgba(34,26,14,.50)'; ctx.lineWidth=1.2;
      RU.forEach(function(r){
        ctx.beginPath();
        r.forEach(function(pt,i){ var p=proj(pt[0],pt[1]); i?ctx.lineTo(toX(p),toY(p)):ctx.moveTo(toX(p),toY(p)); });
        ctx.closePath(); ctx.fill(); ctx.stroke();
      });

      /* точки: чем плотнее, тем ярче — московский узел светится сам собой */
      var zoomed = cam.span < VIEWS.all.span*0.2;
      var r = zoomed ? 3.2 : 2.2;
      ctx.fillStyle = amber; ctx.globalAlpha = zoomed ? .80 : .66;
      for(var k=0;k<order.length;k++){
        if(order[k][1] > reveal) break;
        var p3 = proj(PTS[order[k][0]][0], PTS[order[k][0]][1]);
        var x3 = toX(p3), y3 = toY(p3);
        if(x3<-20||x3>W+20||y3<-20||y3>H+20) continue;
        ctx.beginPath(); ctx.arc(x3,y3,r,0,6.2832); ctx.fill();
      }
      ctx.globalAlpha = 1;

      /* масштабная линейка: меряем по месту, проекция равновеликая */
      (function(){
        var mid=unproj(cam.x, cam.y);
        var a=proj(mid[0],mid[1]), b2=proj(mid[0],mid[1]+0.1);
        var pxPerKm=Math.hypot(b2[0]-a[0],b2[1]-a[1])*scale/11.12;   /* 0.1° широты ≈ 11,12 км */
        var NICE=[10,25,50,100,250,500,1000,2000];
        var km=NICE[0];
        for(var i=0;i<NICE.length;i++){ km=NICE[i]; if(km*pxPerKm>=90) break; }
        var w=km*pxPerKm;
        if(!(w>10 && w<W*0.5)) return;
        var bx=18, by=H-20;
        ctx.strokeStyle='rgba(34,26,14,.45)'; ctx.lineWidth=1;
        ctx.beginPath(); ctx.moveTo(bx,by-4); ctx.lineTo(bx,by); ctx.lineTo(bx+w,by); ctx.lineTo(bx+w,by-4); ctx.stroke();
        ctx.fillStyle='rgba(34,26,14,.55)';
        ctx.font='10px ui-monospace,SFMono-Regular,Menlo,monospace';
        ctx.textAlign='center'; ctx.fillText(km+' км', bx+w/2, by-8); ctx.textAlign='left';
      })();

      /* подсвеченная точка */
      if(hoverI>=0){
        var ph = proj(PTS[hoverI][0], PTS[hoverI][1]);
        var xh=toX(ph), yh=toY(ph);
        ctx.strokeStyle=amber; ctx.lineWidth=1.2;
        ctx.beginPath(); ctx.arc(xh,yh,r+6,0,6.2832); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(xh-14,yh); ctx.lineTo(xh-r-8,yh);
        ctx.moveTo(xh+r+8,yh); ctx.lineTo(xh+14,yh);
        ctx.moveTo(xh,yh-14); ctx.lineTo(xh,yh-r-8);
        ctx.moveTo(xh,yh+r+8); ctx.lineTo(xh,yh+14); ctx.stroke();
      }
    }

    /* ---- анимация перелёта между видами ---- */
    var raf=0;
    function tick(){
      raf=0;
      var need=false;
      if(anim<1){
        anim=Math.min(1, anim + (reduced?1:0.038));
        var t=anim<.5 ? 4*anim*anim*anim : 1-Math.pow(-2*anim+2,3)/2;
        cam.x = from.x + (target.x-from.x)*t;
        cam.y = from.y + (target.y-from.y)*t;
        /* масштаб интерполируем логарифмически — иначе перелёт «прыгает» */
        cam.span = Math.exp(Math.log(from.span) + (Math.log(target.span)-Math.log(from.span))*t);
        need=true;
      }
      if(reveal<1){ reveal=Math.min(1, reveal + (reduced?1:0.02)); need=true; }
      draw();
      if(need) raf=requestAnimationFrame(tick);
    }
    function schedule(){ if(!raf) raf=requestAnimationFrame(tick); }

    var note=document.getElementById('geo-note');
    var NOTE={ all:'Россия · 695 площадок', msk:'Москва и область · 618 площадок' };
    function goto(name){
      current=name;
      if(note) note.textContent = NOTE[name] || '';
      from = Object.assign({}, cam); target = Object.assign({}, VIEWS[name]); anim=0; schedule();
    }

    /* ---- события ---- */
    document.querySelectorAll('.geo-btn').forEach(function(b){
      b.addEventListener('click', function(){
        document.querySelectorAll('.geo-btn').forEach(function(o){
          o.classList.toggle('on', o===b); o.setAttribute('aria-pressed', String(o===b));
        });
        goto(b.dataset.view);
      });
    });

    var read = document.getElementById('geo-read');
    function pick(ev){
      var rct=cv.getBoundingClientRect();
      var mx=ev.clientX-rct.left, my=ev.clientY-rct.top;
      var best=-1, bd=18*18;
      for(var i=0;i<PTS.length;i++){
        var p=proj(PTS[i][0],PTS[i][1]); var dx=toX(p)-mx, dy=toY(p)-my, d=dx*dx+dy*dy;
        if(d<bd){ bd=d; best=i; }
      }
      if(best!==hoverI){
        hoverI=best;
        read.innerHTML = best<0 ? '<span>наведите на точку</span>'
          : '<b>'+PTS[best][1].toFixed(3).replace('.',',')+'° с. ш.</b><b>'+PTS[best][0].toFixed(3).replace('.',',')+'° в. д.</b>';
        schedule();
      }
    }
    cv.addEventListener('pointermove', pick, {passive:true});
    cv.addEventListener('pointerleave', function(){
      if(hoverI!==-1){ hoverI=-1; read.innerHTML='<span>наведите на точку</span>'; schedule(); }
    }, {passive:true});

    var ro = window.ResizeObserver ? new ResizeObserver(function(){ layout(); schedule(); }) : null;
    if(ro) ro.observe(cv); else addEventListener('resize', function(){ layout(); schedule(); });

    /* карта просыпается, когда доезжает до экрана */
    buildOrder(); layout(); cam=Object.assign({},VIEWS.all); target=Object.assign({},VIEWS.all);
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(en){
        if(en[0].isIntersecting){ schedule(); io.disconnect(); }
      },{rootMargin:'20% 0px'});
      io.observe(cv);
    } else { reveal=1; schedule(); }
  })();
</script>
