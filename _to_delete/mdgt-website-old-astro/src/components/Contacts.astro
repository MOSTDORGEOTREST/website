---
interface Props { subpage?: boolean }
const { subpage = false } = Astro.props;
---
<section id="contacts" class="light-sec" aria-labelledby="contacts-title">
  {!subpage && <div class="fin-watermark" aria-hidden="true">−48 м</div>}
  <div class="wrap fin">
    <div class="fin-head">
      <span class="d-eyebrow">{subpage ? 'Контакты' : 'Финал · Забой достигнут'}</span>
      <h2 id="contacts-title">Дальше — вместе с нами</h2>
      <p>Пришлите задачу — подберём программу испытаний, сроки и стоимость. Отвечаем в рабочие дни с 10:00 до 18:00.</p>
    </div>
    <div class="fin-grid">
      <div class="fin-main">
        <div class="fm-glow" aria-hidden="true"></div>
        <div class="fm-strat" aria-hidden="true" title="Разрез: 6 лабораторий"></div>
        <span class="fm-label">Напишите или позвоните</span>
        <a class="fm-phone" href="tel:+74956566910">+7 495 656-69-10</a>
        <p class="fm-note">Опишите объект и задачу — вернёмся с программой испытаний и сроками в течение рабочего дня.</p>
        <a class="btn btn-primary" href="mailto:mail@mdgt.ru"><span class="btn-fill" aria-hidden="true"></span><span>Написать: mail@mdgt.ru</span></a>
        <div class="fm-row">
          <button class="btn btn-ghost" type="button" data-price-open><span class="btn-fill" aria-hidden="true"></span><span>Прайс-лист</span></button>
          <a class="btn btn-ghost" href="https://mdgt.ru/3d/output-3/index.html" target="_blank" rel="noopener"><span class="btn-fill" aria-hidden="true"></span><span>3D-тур по лаборатории</span></a>
        </div>
      </div>
      <div class="fin-side">
        <div class="contact-card">
          <div class="cc-label">Телефоны</div>
          <a class="cc-row" href="tel:+74956566910"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5c0-1 1-2 2-2h2l2 5-2 1.5a13 13 0 0 0 6.5 6.5L16 14l5 2v2c0 1-1 2-2 2A16 16 0 0 1 4 5z"/></svg><span>+7 495 656-69-10</span></a>
          <a class="cc-row" href="tel:+74956566580"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5c0-1 1-2 2-2h2l2 5-2 1.5a13 13 0 0 0 6.5 6.5L16 14l5 2v2c0 1-1 2-2 2A16 16 0 0 1 4 5z"/></svg><span>+7 495 656-65-80</span></a>
          <a class="cc-row" href="tel:+74956566859"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5c0-1 1-2 2-2h2l2 5-2 1.5a13 13 0 0 0 6.5 6.5L16 14l5 2v2c0 1-1 2-2 2A16 16 0 0 1 4 5z"/></svg><span>+7 495 656-68-59</span></a>
        </div>
        <div class="contact-card">
          <div class="cc-label">Почта</div>
          <a class="cc-row" href="mailto:mail@mdgt.ru"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>mail@mdgt.ru</span></a>
          <a class="cc-row" href="mailto:mostdorgeotrest@mail.ru"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>mostdorgeotrest@mail.ru</span></a>
          <a class="cc-row" href="mailto:education@mdgt.ru"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>education@mdgt.ru</span></a>
        </div>
        <div class="contact-card">
          <div class="cc-label">Адрес и режим</div>
          <div class="cc-row cc-row--static"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg><span>г. Москва, ул. Искры, д. 31, к. 1, этаж 4</span></div>
          <div class="cc-row cc-row--static"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg><span>Пн–Пт 10:00–18:00</span></div>
          <a class="cc-map" href="https://yandex.ru/maps/?text=%D0%9C%D0%BE%D1%81%D0%BA%D0%B2%D0%B0%2C%20%D1%83%D0%BB%D0%B8%D1%86%D0%B0%20%D0%98%D1%81%D0%BA%D1%80%D1%8B%2C%2031%D0%BA1" target="_blank" rel="noopener">Открыть в Яндекс.Картах&nbsp;&rarr;</a>
        </div>
      </div>
    </div>
    <div class="strat-strip" aria-hidden="true"></div>
    <footer>
      <div class="foot-row">
        <span>© АО «МОСТДОРГЕОТРЕСТ», 2008–2026</span>
        <nav class="foot-nav" aria-label="Разделы">
          <a href="/oborudovanie/">Оборудование</a>
          <a href="/kursy/">Курсы</a>
          <a href="/soft/">Софты</a>
        </nav>
        <span class="mono">ИНН 7716750744 · ОГРН 1137746653021{!subpage && ' · 55.87N 37.66E · z = −48.0 м'}</span>
      </div>
    </footer>
  </div>
</section>
